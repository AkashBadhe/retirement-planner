# =============================================================================
# Frontend (React — client/)
# =============================================================================

# dependencies
client/node_modules
node_modules

# testing
client/coverage

# production
client/build

# misc
.DS_Store
client/.env.local
client/.env.development.local
client/.env.test.local
client/.env.production.local
client/.env.production

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =============================================================================
# Backend (NestJS API)
# =============================================================================

api/node_modules
api/dist
api/.env
api/.env.*
!api/.env.example

# =============================================================================
# Terraform
# =============================================================================

# State files (contain secrets like passwords, connection strings)
terraform/*.tfstate
terraform/*.tfstate.*
terraform/terraform.tfstate.d/
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/tfplan-*

# Secret variable files
terraform/environments/*.secrets.tfvars
terraform/*.auto.tfvars

# Crash logs
terraform/crash.log
terraform/crash.*.log

# =============================================================================
# Environment / Secrets
# =============================================================================

.env
.env.production
*.secrets.tfvars

# =============================================================================
# IDE / Editor
# =============================================================================

.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

