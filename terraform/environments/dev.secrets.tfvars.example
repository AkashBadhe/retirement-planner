##############################################################################
# dev.secrets.tfvars.example
# Copy this to dev.secrets.tfvars and fill real values.
# DO NOT COMMIT dev.secrets.tfvars (already ignored by .gitignore).
##############################################################################

# Required
jwt_secret = "replace-with-long-random-secret"

# Optional ACS sender customization (domain is auto-generated by Terraform)
# acs_email_sender_username = "donotreply"
# acs_email_sender_display_name = "CashFlow"

# WhatsApp (Meta Cloud API)
whatsapp_verify_token = "replace-with-webhook-verify-token"
whatsapp_access_token = "replace-with-meta-access-token"
whatsapp_phone_number_id = "replace-with-phone-number-id"
whatsapp_business_account_id = "replace-with-business-account-id"

# Optional OAuth (keep empty if not used)
google_client_id = ""
google_client_secret = ""
github_client_id = ""
github_client_secret = ""
