##############################################################################
# prod.secrets.tfvars.example
# Copy this to prod.secrets.tfvars and fill real values.
# DO NOT COMMIT prod.secrets.tfvars (already ignored by .gitignore).
##############################################################################

# Required — use a unique, strong random string (different from dev/uat)
jwt_secret = "replace-with-long-random-secret-for-prod"

# WhatsApp (Meta Cloud API) — production credentials
whatsapp_verify_token        = "replace-with-webhook-verify-token"
whatsapp_access_token        = "replace-with-meta-access-token"
whatsapp_phone_number_id     = "replace-with-phone-number-id"
whatsapp_business_account_id = "replace-with-business-account-id"

# OAuth (production credentials from Google/GitHub console)
google_client_id     = ""
google_client_secret = ""
github_client_id     = ""
github_client_secret = ""
